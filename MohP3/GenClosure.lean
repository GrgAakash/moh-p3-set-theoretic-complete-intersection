/-- Entry `(i,j)` of the `x`-closure matrix. -/
def qxA (y : A) (i j : Fin 8) : A := ((qxD i j).1 : A) * y ^ (qxD i j).2

/-- Entry `(i,j)` of the `z`-closure matrix. -/
def qzA (y : A) (i j : Fin 8) : A := ((qzD i j).1 : A) * y ^ (qzD i j).2

/-- The cofactor of `ff j` in the `i`-th `x`-closure identity. -/
def wxA (x y z : A) (i : Fin 8) (j : Fin 4) : A :=
  ∑ t : Fin 4, ((wxD i j t).1 : A) * x ^ (wxD i j t).2.1 * y ^ (wxD i j t).2.2.1 *
    z ^ (wxD i j t).2.2.2

/-- The cofactor of `ff j` in the `i`-th `z`-closure identity. -/
def wzA (x y z : A) (i : Fin 8) (j : Fin 4) : A :=
  ∑ t : Fin 4, ((wzD i j t).1 : A) * x ^ (wzD i j t).2.1 * y ^ (wzD i j t).2.2.1 *
    z ^ (wzD i j t).2.2.2

variable (x y z : A)

/-- The `x`-closure identity for the generator `hh 0`. -/
theorem key_xA_0 :
    (18 : A) * (x * hh x y z 0) =
      (∑ j, qxA y 0 j * hh x y z j) + ∑ j, wxA x y z 0 j * ff x y z j := by
  simp only [hh, ff, qxA, wxA, qxD, wxD, f1, f2, f3, f4, Fin.sum_univ_eight,
    Fin.sum_univ_four, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val,
    Int.cast_zero, Int.cast_ofNat, zero_mul, add_zero, zero_add]
  ring

/-- The `z`-closure identity for the generator `hh 0`. -/
theorem key_zA_0 :
    (18 : A) * (z * hh x y z 0) =
      (∑ j, qzA y 0 j * hh x y z j) + ∑ j, wzA x y z 0 j * ff x y z j := by
  simp only [hh, ff, qzA, wzA, qzD, wzD, f1, f2, f3, f4, Fin.sum_univ_eight,
    Fin.sum_univ_four, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val,
