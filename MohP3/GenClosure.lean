/-- Multiplication by `x` on the eight generators, modulo the curve ideal. -/
theorem key_xA (i : Fin 8) :
    (18 : A) * (x * hh x y z i) =
      (∑ j, qxA y i j * hh x y z j) + ∑ j, wxA x y z i j * ff x y z j := by
  fin_cases i
  exacts [key_xA_0 x y z, key_xA_1 x y z, key_xA_2 x y z, key_xA_3 x y z,
    key_xA_4 x y z, key_xA_5 x y z, key_xA_6 x y z, key_xA_7 x y z]

/-- Multiplication by `z` on the eight generators, modulo the curve ideal. -/
theorem key_zA (i : Fin 8) :
    (18 : A) * (z * hh x y z i) =
      (∑ j, qzA y i j * hh x y z j) + ∑ j, wzA x y z i j * ff x y z j := by
  fin_cases i
  exacts [key_zA_0 x y z, key_zA_1 x y z, key_zA_2 x y z, key_zA_3 x y z,
    key_zA_4 x y z, key_zA_5 x y z, key_zA_6 x y z, key_zA_7 x y z]

/-- The weight estimate for the `x`-closure matrix. -/
theorem qxD_wt (i j : Fin 8) : 6 + sig i ≤ 8 * (qxD i j).2 + sig j := by
  fin_cases i <;> fin_cases j <;> simp [qxD, sig]

/-- The weight estimate for the `z`-closure matrix. -/
theorem qzD_wt (i j : Fin 8) : 10 + sig i ≤ 8 * (qzD i j).2 + sig j := by
  fin_cases i <;> fin_cases j <;> simp [qzD, sig]

/-- The weight estimate for the `x`-closure cofactors. -/
theorem wxD_wt (i : Fin 8) (j : Fin 4) (t : Fin 4) :
    6 + sig i ≤ 6 * (wxD i j t).2.1 + 8 * (wxD i j t).2.2.1 + 10 * (wxD i j t).2.2.2 + tau j := by
  fin_cases i <;> fin_cases j <;> fin_cases t <;> simp [wxD, sig, tau]

/-- The weight estimate for the `z`-closure cofactors. -/
theorem wzD_wt (i : Fin 8) (j : Fin 4) (t : Fin 4) :
    10 + sig i ≤ 6 * (wzD i j t).2.1 + 8 * (wzD i j t).2.2.1 + 10 * (wzD i j t).2.2.2 + tau j := by
  fin_cases i <;> fin_cases j <;> fin_cases t <;> simp [wzD, sig, tau]

end MohP3.Gen
