import Mathlib

/-!
# The Moh P3 certificate over an arbitrary commutative ring

All the polynomial identities of the certificate have integer coefficients, so
they are identities in any commutative ring `A`, for any three elements
`x y z : A`.  This file states and proves them once and for all; the ring
`ℚ[x,y,z]` (file `MohP3.Certificate`) and the formal power series ring
`k[[x,y,z]]` (file `MohP3.FormalLocal`) are then two instantiations.

The only place where a hypothesis on `A` is needed is `P_sq_le_Q`, where the
ten integer scales `d_ij` have to be invertible; we assume `[Algebra ℚ A]`.
-/

noncomputable section

namespace MohP3.Gen

variable {A : Type*} [CommRing A]

def f1 (x y z : A) : A :=
  x^4 - x^2*y^4*z^3 - 2*x*y^6*z^2 - 4*x*y*z - 3*y^3*z^5 + 3*y^3

def f2 (x y z : A) : A :=
  x^3*y - x*y^5*z^3 - 3*x*z^2 - 2*y^7*z^2 + 2*y^2*z

def f3 (x y z : A) : A :=
  2*x^3*z - 3*x^2*y^2 - 2*x*y^4*z^4 - y^6*z^3 + y*z^2

def f4 (x y z : A) : A :=
  x^2*y*z - 2*x*y^3 - y^5*z^4 + z^3

def ell (x y z : A) : A :=
  64*x^4*y*z^2 - 40*x^3*y^3*z + 72*x*y^2*z^3 - 81*y^4*z^2

def kappa (x y z : A) : A :=
  -40*x^3*y^2*z^2 + 25*x^2*y^4*z + 36*y^3*z^3

def H1 (x y z : A) : A := 81*f4 x y z - 24*x*f1 x y z + ell x y z*f3 x y z
def H2 (x y z : A) : A := -12*y*f1 x y z + 27*x*f2 x y z + kappa x y z*f3 x y z

/-- The curve ideal. -/
def P (x y z : A) : Ideal A := Ideal.span ({f1 x y z, f2 x y z, f3 x y z, f4 x y z} : Set A)

/-- The ideal generated by the two witnesses. -/
def Q (x y z : A) : Ideal A := Ideal.span ({H1 x y z, H2 x y z} : Set A)

variable (x y z : A)

lemma f1_mem : f1 x y z ∈ P x y z := Ideal.subset_span (by simp)
lemma f2_mem : f2 x y z ∈ P x y z := Ideal.subset_span (by simp)
lemma f3_mem : f3 x y z ∈ P x y z := Ideal.subset_span (by simp)
lemma f4_mem : f4 x y z ∈ P x y z := Ideal.subset_span (by simp)
lemma H1_mem : H1 x y z ∈ Q x y z := Ideal.subset_span (by simp)
lemma H2_mem : H2 x y z ∈ Q x y z := Ideal.subset_span (by simp)

/-- Membership test for `P` from an explicit representation. -/
lemma mem_P_of_eq {x y z : A} {g c1 c2 c3 c4 : A}
    (h : g = c1 * f1 x y z + c2 * f2 x y z + c3 * f3 x y z + c4 * f4 x y z) : g ∈ P x y z := by
  rw [h]
  exact (P x y z).add_mem ((P x y z).add_mem ((P x y z).add_mem
    (Ideal.mul_mem_left _ _ (f1_mem x y z)) (Ideal.mul_mem_left _ _ (f2_mem x y z)))
    (Ideal.mul_mem_left _ _ (f3_mem x y z))) (Ideal.mul_mem_left _ _ (f4_mem x y z))

/-- Membership test for `Q` from an explicit representation. -/
lemma mem_Q_of_eq {x y z : A} {g a b : A} (h : g = a * H1 x y z + b * H2 x y z) : g ∈ Q x y z := by
  rw [h]
  exact (Q x y z).add_mem (Ideal.mul_mem_left _ _ (H1_mem x y z))
    (Ideal.mul_mem_left _ _ (H2_mem x y z))

/-- Over a `ℚ`-algebra a nonzero natural number is invertible, so it may be
cancelled from an ideal membership. -/
lemma mem_of_nsmul_mem [Algebra ℚ A] {I : Ideal A} {n : ℕ} (hn : n ≠ 0) {g : A}
    (h : (n : A) * g ∈ I) : g ∈ I := by
  have hcast : ((n : ℕ) : A) = algebraMap ℚ A (n : ℚ) := by
    simp
  have hunit : IsUnit ((n : ℕ) : A) := by
    rw [hcast]
    exact (isUnit_iff_ne_zero.mpr (Nat.cast_ne_zero.mpr hn)).map (algebraMap ℚ A)
  obtain ⟨u, hu⟩ := hunit
  have := Ideal.mul_mem_left I (↑u⁻¹) h
  rwa [← mul_assoc, ← hu, Units.inv_mul, one_mul] at this

/-- Expanded form of `H1`, as recorded in `witnesses.txt`. -/
theorem H1_expanded : H1 x y z =
    128*x^7*y*z^3 - 272*x^6*y^3*z^2 - 128*x^5*y^5*z^6
    + 120*x^5*y^5*z - 24*x^5 + 16*x^4*y^7*z^5
    + 208*x^4*y^2*z^4 + 40*x^3*y^9*z^4 - 394*x^3*y^4*z^3
    - 144*x^2*y^6*z^7 + 291*x^2*y^6*z^2 + 177*x^2*y*z
    + 90*x*y^8*z^6 + 144*x*y^3*z^5 - 234*x*y^3
    + 81*y^10*z^5 - 162*y^5*z^4 + 81*z^3 := by
  simp only [H1, f1, f3, f4, ell]
  ring

/-- Expanded form of `H2`, as recorded in `witnesses.txt`. -/
theorem H2_expanded : H2 x y z =
    -80*x^6*y^2*z^3 + 170*x^5*y^4*z^2 + 80*x^4*y^6*z^6
    - 75*x^4*y^6*z + 15*x^4*y - 10*x^3*y^8*z^5
    + 32*x^3*y^3*z^4 - 25*x^2*y^10*z^4 - 98*x^2*y^5*z^3
    - 81*x^2*z^2 - 72*x*y^7*z^7 - 30*x*y^7*z^2
    + 102*x*y^2*z - 36*y^9*z^6 + 72*y^4*z^5 - 36*y^4 := by
  simp only [H2, f1, f2, f3, kappa]
  ring

/-- The first reverse identity. -/
theorem H1_eq : H1 x y z = (-24*x)*f1 x y z + ell x y z*f3 x y z + 81*f4 x y z := by
  simp only [H1]; ring

/-- The second reverse identity. -/
theorem H2_eq : H2 x y z = (-12*y)*f1 x y z + (27*x)*f2 x y z + kappa x y z*f3 x y z := by
  simp only [H2]

theorem H1_mem_P : H1 x y z ∈ P x y z :=
  mem_P_of_eq (c1 := -24*x) (c2 := 0) (c3 := ell x y z) (c4 := 81) (by simp only [H1]; ring)

theorem H2_mem_P : H2 x y z ∈ P x y z :=
  mem_P_of_eq (c1 := -12*y) (c2 := 27*x) (c3 := kappa x y z) (c4 := 0) (by simp only [H2]; ring)

/-- `Q ≤ P`. -/
theorem Q_le_P : Q x y z ≤ P x y z := by
  rw [Q, Ideal.span_le]
  rintro g (rfl | rfl)
  · exact H1_mem_P x y z
  · exact H2_mem_P x y z

