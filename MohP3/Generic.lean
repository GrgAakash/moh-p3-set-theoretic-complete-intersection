/-- `P ^ 2 ≤ Q`: every product of two generators lies in `Q`, by the ten
scaled identities. -/
theorem P_sq_le_Q : P x y z ^ 2 ≤ Q x y z := by
  rw [pow_two, P, Ideal.span_mul_span, Ideal.span_le]
  rintro g ⟨a, ha, b, hb, rfl⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
  show a * b ∈ Q x y z
  rcases ha with rfl | rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl | rfl
  all_goals first
    | exact f1f1_mem_Q x y z | exact f1f2_mem_Q x y z | exact f1f3_mem_Q x y z
    | exact f1f4_mem_Q x y z | exact f2f2_mem_Q x y z | exact f2f3_mem_Q x y z
    | exact f2f4_mem_Q x y z | exact f3f3_mem_Q x y z | exact f3f4_mem_Q x y z
    | exact f4f4_mem_Q x y z
    | (rw [mul_comm]; first
        | exact f1f2_mem_Q x y z | exact f1f3_mem_Q x y z | exact f1f4_mem_Q x y z
        | exact f2f3_mem_Q x y z | exact f2f4_mem_Q x y z | exact f3f4_mem_Q x y z)

/-- From `P^2 ≤ Q ≤ P` the two ideals have the same radical, over any
`ℚ`-algebra. -/
theorem radical_Q_eq_radical_P : (Q x y z).radical = (P x y z).radical := by
  refine le_antisymm (Ideal.radical_mono (Q_le_P x y z)) ?_
  intro a ha
  rw [Ideal.mem_radical_iff] at ha ⊢
  obtain ⟨n, hn⟩ := ha
  exact ⟨n*2, by
    rw [pow_mul]
    exact P_sq_le_Q x y z (Ideal.pow_mem_pow hn 2)⟩

end MohP3.Gen
